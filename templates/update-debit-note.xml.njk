<ENVELOPE>
  <HEADER><TALLYREQUEST>Import Data</TALLYREQUEST></HEADER>
  <BODY>
    <IMPORTDATA>
      <REQUESTDESC>
        <REPORTNAME>Vouchers</REPORTNAME>
      </REQUESTDESC>
      <REQUESTDATA>
        <TALLYMESSAGE xmlns:UDF="TallyUDF">
          <VOUCHER DATE="{{ tallyDate }}" TAGNAME="Voucher Number" TAGVALUE="{{ voucherNumber }}" VCHTYPE="Debit Note" ACTION="Alter" OBJVIEW="Invoice Voucher View">
            <DATE>{{ tallyDate }}</DATE>
            <VOUCHERTYPENAME>Debit Note</VOUCHERTYPENAME>
            <VCHENTRYMODE>Item Invoice</VCHENTRYMODE>
            <ISINVOICE>Yes</ISINVOICE>
            <NARRATION>{{ narration }}</NARRATION>
            <PARTYNAME>{{ partyLedger }}</PARTYNAME>
            <PARTYLEDGERNAME>{{ partyLedger }}</PARTYLEDGERNAME>
            {% for item in items %}<ALLINVENTORYENTRIES.LIST>
              <STOCKITEMNAME>{{ item.stockItem }}</STOCKITEMNAME>
              <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
              <RATE>{{ item.rate }}/{{ item.unit }}</RATE>
              {% if item.discountPercent %}<DISCOUNT>{{ item.discountPercent }}</DISCOUNT>{% endif %}
              <AMOUNT>{{ item.amount }}</AMOUNT>
              <ACTUALQTY> {{ item.qty }} {{ item.unit }}</ACTUALQTY>
              <BILLEDQTY> {{ item.qty }} {{ item.unit }}</BILLEDQTY>
              {% if item.godown %}<BATCHALLOCATIONS.LIST>
                <GODOWNNAME>{{ item.godown }}</GODOWNNAME>
                <BATCHNAME>{{ item.batchName }}</BATCHNAME>
                <AMOUNT>{{ item.amount }}</AMOUNT>
                <ACTUALQTY> {{ item.qty }} {{ item.unit }}</ACTUALQTY>
                <BILLEDQTY> {{ item.qty }} {{ item.unit }}</BILLEDQTY>
              </BATCHALLOCATIONS.LIST>{% endif %}
              <ACCOUNTINGALLOCATIONS.LIST>
                <LEDGERNAME>{{ item.purchaseLedger }}</LEDGERNAME>
                <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
                <AMOUNT>{{ item.amount }}</AMOUNT>
              </ACCOUNTINGALLOCATIONS.LIST>
            </ALLINVENTORYENTRIES.LIST>
            {% endfor %}<LEDGERENTRIES.LIST>
              <LEDGERNAME>{{ partyLedger }}</LEDGERNAME>
              <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
              <ISPARTYLEDGER>Yes</ISPARTYLEDGER>
              <AMOUNT>-{{ partyAmount }}</AMOUNT>
              {% if billName %}<BILLALLOCATIONS.LIST>
                <NAME>{{ billName }}</NAME>
                <BILLTYPE>{{ billType }}</BILLTYPE>
                <AMOUNT>-{{ partyAmount }}</AMOUNT>
              </BILLALLOCATIONS.LIST>{% endif %}
            </LEDGERENTRIES.LIST>
            {% for group in taxGroups %}<LEDGERENTRIES.LIST>
              <LEDGERNAME>{{ group.vatLedger }}</LEDGERNAME>
              <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
              <AMOUNT>{{ group.vatAmount }}</AMOUNT>
              <RATEOFINVOICETAX.LIST TYPE="Number"><RATEOFINVOICETAX> {{ group.vatRatePercent }}</RATEOFINVOICETAX></RATEOFINVOICETAX.LIST>
              <VATEXPAMOUNT>{{ group.vatAmount }}</VATEXPAMOUNT>
            </LEDGERENTRIES.LIST>
            {% endfor %}
          </VOUCHER>
        </TALLYMESSAGE>
      </REQUESTDATA>
    </IMPORTDATA>
  </BODY>
</ENVELOPE>
