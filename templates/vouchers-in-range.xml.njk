<ENVELOPE>
  <HEADER>
    <VERSION>1</VERSION>
    <TALLYREQUEST>Export</TALLYREQUEST>
    <TYPE>Data</TYPE>
    <ID>PNPCMCPVouchersInRange</ID>
  </HEADER>
  <BODY>
    <DESC>
      <STATICVARIABLES>
        <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
        <SVFROMDATE>{{ fromDate }}</SVFROMDATE>
        <SVTODATE>{{ toDate }}</SVTODATE>
      </STATICVARIABLES>
      <TDL>
        <TDLMESSAGE>
          <REPORT NAME="PNPCMCPVouchersInRange">
            <FORMS>PNPCMCPVouchersInRangeForm</FORMS>
          </REPORT>
          <FORM NAME="PNPCMCPVouchersInRangeForm">
            <PARTS>PNPCMCPVouchersInRangePart</PARTS>
            <XMLTAG>DATA</XMLTAG>
          </FORM>
          <PART NAME="PNPCMCPVouchersInRangePart">
            <LINES>PNPCMCPVouchersInRangeLine</LINES>
            <REPEAT>PNPCMCPVouchersInRangeLine : PNPCMCPVouchersInRangeCollection</REPEAT>
            <SCROLLED>Vertical</SCROLLED>
          </PART>
          <LINE NAME="PNPCMCPVouchersInRangeLine">
            <FIELDS>FldGuid,FldDate,FldVoucherType,FldVoucherNumber,FldPartyLedger,FldAmount,FldNarration</FIELDS>
            <XMLTAG>ROW</XMLTAG>
          </LINE>
          <FIELD NAME="FldGuid"><SET>$Guid</SET><XMLTAG>guid</XMLTAG></FIELD>
          <FIELD NAME="FldDate"><SET>$Date</SET><XMLTAG>date</XMLTAG></FIELD>
          <FIELD NAME="FldVoucherType"><SET>$VoucherTypeName</SET><XMLTAG>voucher_type</XMLTAG></FIELD>
          <FIELD NAME="FldVoucherNumber"><SET>$VoucherNumber</SET><XMLTAG>voucher_number</XMLTAG></FIELD>
          <FIELD NAME="FldPartyLedger"><SET>$PartyLedgerName</SET><XMLTAG>party_ledger</XMLTAG></FIELD>
          <FIELD NAME="FldAmount"><SET>$$StringFindAndReplace:(if $$IsDebit:($AllLedgerEntries[1,@@FilterPartyLedger].Amount) then -$$NumValue:$AllLedgerEntries[1,@@FilterPartyLedger].Amount else $$NumValue:$AllLedgerEntries[1,@@FilterPartyLedger].Amount):"(-)":"-"</SET><XMLTAG>amount</XMLTAG></FIELD>
          <FIELD NAME="FldNarration"><SET>$Narration</SET><XMLTAG>narration</XMLTAG></FIELD>
          <COLLECTION NAME="PNPCMCPVouchersInRangeCollection">
            <TYPE>Voucher</TYPE>
            <FETCH>AllLedgerEntries,Narration,PartyLedgerName</FETCH>
            <FILTER>FilterCancelledVouchers,FilterOptionalVouchers</FILTER>
          </COLLECTION>
          <SYSTEM TYPE="Formulae" NAME="FilterPartyLedger">$$IsEqual:$LedgerName:$PartyLedgerName</SYSTEM>
          <SYSTEM TYPE="Formulae" NAME="FilterCancelledVouchers">NOT $IsCancelled</SYSTEM>
          <SYSTEM TYPE="Formulae" NAME="FilterOptionalVouchers">NOT $IsOptional</SYSTEM>
        </TDLMESSAGE>
      </TDL>
    </DESC>
  </BODY>
</ENVELOPE>
