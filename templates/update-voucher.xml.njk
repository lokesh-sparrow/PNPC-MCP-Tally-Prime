<ENVELOPE>
  <HEADER><TALLYREQUEST>Import Data</TALLYREQUEST></HEADER>
  <BODY>
    <IMPORTDATA>
      <REQUESTDESC>
        <REPORTNAME>Vouchers</REPORTNAME>
      </REQUESTDESC>
      <REQUESTDATA>
        <TALLYMESSAGE xmlns:UDF="TallyUDF">
          <VOUCHER DATE="{{ tallyDate }}" TAGNAME="Voucher Number" TAGVALUE="{{ voucherNumber }}" VCHTYPE="{{ voucherType }}" ACTION="Alter"{% if isAccountingInvoice %} OBJVIEW="Invoice Voucher View"{% endif %}>
            <VOUCHERTYPENAME>{{ voucherType }}</VOUCHERTYPENAME>
            {% if entryMode %}<PERSISTEDVIEW>{% if isAccountingInvoice %}Invoice Voucher View{% else %}Accounting Voucher View{% endif %}</PERSISTEDVIEW>
            <VCHENTRYMODE>{{ entryMode }}</VCHENTRYMODE>
            <ISINVOICE>{% if isAccountingInvoice %}Yes{% else %}No{% endif %}</ISINVOICE>{% endif %}
            {% if isAccountingInvoice %}<PARTYNAME>{{ partyLedger }}</PARTYNAME>
            <PARTYLEDGERNAME>{{ partyLedger }}</PARTYLEDGERNAME>
            <BASICBASEPARTYNAME>{{ partyLedger }}</BASICBASEPARTYNAME>
            {% if party %}<PARTYMAILINGNAME>{{ buyerName or party.mailingName }}</PARTYMAILINGNAME>
            <BASICBUYERNAME>{{ party.mailingName }}</BASICBUYERNAME>
            <CONSIGNEEMAILINGNAME>{{ party.mailingName }}</CONSIGNEEMAILINGNAME>
            {% if party.address %}<ADDRESS.LIST TYPE="String">{% for line in party.address %}<ADDRESS>{{ line }}</ADDRESS>{% endfor %}</ADDRESS.LIST>
            <BASICBUYERADDRESS.LIST TYPE="String">{% for line in party.address %}<BASICBUYERADDRESS>{{ line }}</BASICBUYERADDRESS>{% endfor %}</BASICBUYERADDRESS.LIST>{% endif %}
            {% if party.vatDealerType %}<VATDEALERTYPE>{{ party.vatDealerType }}</VATDEALERTYPE>{% endif %}
            {% if party.state %}{% if not buyerState %}<STATENAME>{{ party.state }}</STATENAME>{% endif %}<CONSIGNEESTATENAME>{{ party.state }}</CONSIGNEESTATENAME>{% endif %}
            {% if party.country %}{% if not buyerCountry %}<COUNTRYOFRESIDENCE>{{ party.country }}</COUNTRYOFRESIDENCE>{% endif %}<CONSIGNEECOUNTRYNAME>{{ party.country }}</CONSIGNEECOUNTRYNAME>{% endif %}
            {% if party.trn and not buyerTrn %}<TRADERCONSVATTINNO>{{ party.trn }}</TRADERCONSVATTINNO>
            <BASICBUYERSSALESTAXNO>{{ party.trn }}</BASICBUYERSSALESTAXNO>{% endif %}{% endif %}{% endif %}
            {% if buyerName and not isAccountingInvoice %}<PARTYMAILINGNAME>{{ buyerName }}</PARTYMAILINGNAME>
            {% endif %}
            {% if reference %}<REFERENCE>{{ reference }}</REFERENCE>{% endif %}
            {% if referenceDate %}<REFERENCEDATE>{{ referenceDate }}</REFERENCEDATE>{% endif %}
            {% if buyerTrn %}<TRADERCONSVATTINNO>{{ buyerTrn }}</TRADERCONSVATTINNO>
            <BASICBUYERSSALESTAXNO>{{ buyerTrn }}</BASICBUYERSSALESTAXNO>{% endif %}
            {% if buyerState %}<STATENAME>{{ buyerState }}</STATENAME>{% endif %}
            {% if buyerCountry %}<COUNTRYOFRESIDENCE>{{ buyerCountry }}</COUNTRYOFRESIDENCE>{% endif %}
            {% if placeOfSupplyEmirate %}<EMIRATEPOS>{{ placeOfSupplyEmirate }}</EMIRATEPOS>{% endif %}
            {% if placeOfSupplyCountry %}<PLACEOFSUPPLYCOUNTRY>{{ placeOfSupplyCountry }}</PLACEOFSUPPLYCOUNTRY>{% endif %}
            <NARRATION>{{ narration }}</NARRATION>
            {% for entry in entries %}{% if isAccountingInvoice %}<LEDGERENTRIES.LIST>{% else %}<ALLLEDGERENTRIES.LIST>{% endif %}
              <LEDGERNAME>{{ entry.ledgerName }}</LEDGERNAME>
              {% if entry.isPartyLedger %}<ISPARTYLEDGER>Yes</ISPARTYLEDGER>{% endif %}
              <ISDEEMEDPOSITIVE>{{ entry.isDeemedPositive }}</ISDEEMEDPOSITIVE>
              <AMOUNT>{{ entry.amount }}</AMOUNT>
              {% if isAccountingInvoice and not entry.isPartyLedger %}<VATEXPAMOUNT>{{ entry.amount }}</VATEXPAMOUNT>{% endif %}
              {% if entry.description %}<UDF:USERDESCRIPTION.LIST DESC="`User Description`" ISLIST="YES" TYPE="String" INDEX="29">
                {% for line in entry.description %}<UDF:USERDESCRIPTION DESC="`User Description`">{{ line }}</UDF:USERDESCRIPTION>
                {% endfor %}
              </UDF:USERDESCRIPTION.LIST>{% endif %}
              {% if entry.billName %}<BILLALLOCATIONS.LIST>
                <NAME>{{ entry.billName }}</NAME>
                <BILLTYPE>{{ entry.billType }}</BILLTYPE>
                <AMOUNT>{{ entry.amount }}</AMOUNT>
              </BILLALLOCATIONS.LIST>{% endif %}
              {% if entry.costCentre %}<CATEGORYALLOCATIONS.LIST>
                <CATEGORY>{{ entry.costCategory }}</CATEGORY>
                <ISDEEMEDPOSITIVE>{{ entry.isDeemedPositive }}</ISDEEMEDPOSITIVE>
                <COSTCENTREALLOCATIONS.LIST>
                  <NAME>{{ entry.costCentre }}</NAME>
                  <AMOUNT>{{ entry.amount }}</AMOUNT>
                </COSTCENTREALLOCATIONS.LIST>
              </CATEGORYALLOCATIONS.LIST>{% endif %}
            {% if isAccountingInvoice %}</LEDGERENTRIES.LIST>{% else %}</ALLLEDGERENTRIES.LIST>{% endif %}
            {% endfor %}
          </VOUCHER>
        </TALLYMESSAGE>
      </REQUESTDATA>
    </IMPORTDATA>
  </BODY>
</ENVELOPE>
