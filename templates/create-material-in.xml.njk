<ENVELOPE>
  <HEADER><TALLYREQUEST>Import Data</TALLYREQUEST></HEADER>
  <BODY>
    <IMPORTDATA>
      <REQUESTDESC>
        <REPORTNAME>Vouchers</REPORTNAME>
      </REQUESTDESC>
      <REQUESTDATA>
        <TALLYMESSAGE xmlns:UDF="TallyUDF">
          <VOUCHER VCHTYPE="Material In" ACTION="Create">
            <DATE>{{ tallyDate }}</DATE>
            <VOUCHERTYPENAME>Material In</VOUCHERTYPENAME>
            <ISINVOICE>Yes</ISINVOICE>
            <PERSISTEDVIEW>Multi Consumption Voucher View</PERSISTEDVIEW>
            {% if voucherNumber %}<VOUCHERNUMBER>{{ voucherNumber }}</VOUCHERNUMBER>{% endif %}
            <PARTYNAME>{{ partyLedger }}</PARTYNAME>
            <PARTYLEDGERNAME>{{ partyLedger }}</PARTYLEDGERNAME>
            <NARRATION>{{ narration }}</NARRATION>
            <LEDGERENTRIES.LIST>
              <LEDGERNAME>{{ partyLedger }}</LEDGERNAME>
              <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
              <ISPARTYLEDGER>Yes</ISPARTYLEDGER>
              <AMOUNT>-{{ totalAmount }}</AMOUNT>
            </LEDGERENTRIES.LIST>
            {% for item in items %}<INVENTORYENTRIESIN.LIST>
              <STOCKITEMNAME>{{ item.stockItem }}</STOCKITEMNAME>
              <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
              <RATE>{{ item.rate }}/{{ item.unit }}</RATE>
              <AMOUNT>-{{ item.amount }}</AMOUNT>
              <ACTUALQTY>{{ item.qty }} {{ item.unit }}</ACTUALQTY>
              <BILLEDQTY>{{ item.qty }} {{ item.unit }}</BILLEDQTY>
              {% if item.godown %}<BATCHALLOCATIONS.LIST>
                <GODOWNNAME>{{ item.godown }}</GODOWNNAME>
                <BATCHNAME>{{ item.batchName }}</BATCHNAME>
                <DESTINATIONGODOWNNAME>{{ item.godown }}</DESTINATIONGODOWNNAME>
                <AMOUNT>-{{ item.amount }}</AMOUNT>
                <ACTUALQTY>{{ item.qty }} {{ item.unit }}</ACTUALQTY>
                <BILLEDQTY>{{ item.qty }} {{ item.unit }}</BILLEDQTY>
              </BATCHALLOCATIONS.LIST>{% endif %}
            </INVENTORYENTRIESIN.LIST>
            {% endfor %}
          </VOUCHER>
        </TALLYMESSAGE>
      </REQUESTDATA>
    </IMPORTDATA>
  </BODY>
</ENVELOPE>
