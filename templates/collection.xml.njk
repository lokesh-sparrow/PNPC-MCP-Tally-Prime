<ENVELOPE>
  <HEADER>
    <VERSION>1</VERSION>
    <TALLYREQUEST>Export</TALLYREQUEST>
    <TYPE>Data</TYPE>
    <ID>PNPCMCPReport</ID>
  </HEADER>
  <BODY>
    <DESC>
      <STATICVARIABLES>
        <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
        {% if fromDate %}<SVFROMDATE>{{ fromDate }}</SVFROMDATE>{% endif %}
        {% if toDate %}<SVTODATE>{{ toDate }}</SVTODATE>{% endif %}
      </STATICVARIABLES>
      <TDL>
        <TDLMESSAGE>
          <REPORT NAME="PNPCMCPReport">
            <FORMS>PNPCMCPForm</FORMS>
          </REPORT>
          <FORM NAME="PNPCMCPForm">
            <PARTS>PNPCMCPPart</PARTS>
            <XMLTAG>DATA</XMLTAG>
          </FORM>
          <PART NAME="PNPCMCPPart">
            <LINES>PNPCMCPLine</LINES>
            <REPEAT>PNPCMCPLine : PNPCMCPCollection</REPEAT>
            <SCROLLED>Vertical</SCROLLED>
          </PART>
          <LINE NAME="PNPCMCPLine">
            <FIELDS>{% for field in fields %}fld_{{ field.name }}{% if not loop.last %},{% endif %}{% endfor %}</FIELDS>
            <XMLTAG>ROW</XMLTAG>
          </LINE>
          {% for field in fields %}<FIELD NAME="fld_{{ field.name }}">{% if field.expression %}<SET>{{ field.expression }}</SET>{% elif field.datatype == "date" %}<SET>if $$IsEmpty:${{ field.name }} then "" else $$PyrlYYYYMMDDFormat:${{ field.name }}:"-"</SET>{% elif field.datatype == "amount" %}<SET>$$StringFindAndReplace:(if $$IsDebit:${{ field.name }} then -$$NumValue:${{ field.name }} else $$NumValue:${{ field.name }}):"(-)":"-"</SET>{% elif field.datatype == "boolean" %}<SET>if ${{ field.name }} then 1 else 0</SET>{% elif field.datatype == "number" %}<SET>if $$IsEmpty:${{ field.name }} then 0 else $$StringFindAndReplace:($$String:${{ field.name }}):"(-)":"-"</SET>{% elif field.datatype == "quantity" %}<SET>$$StringFindAndReplace:(if $$IsInwards:${{ field.name }} then $$Number:$$String:${{ field.name }}:"TailUnits" else -$$Number:$$String:${{ field.name }}:"TailUnits"):"(-)":"-"</SET>{% elif field.datatype == "rate" %}<SET>if $$IsEmpty:${{ field.name }} then 0 else $$Number:${{ field.name }}</SET>{% else %}<SET>${{ field.name }}</SET>{% endif %}<XMLTAG>{{ field.name }}</XMLTAG></FIELD>
          {% endfor %}
          <COLLECTION NAME="PNPCMCPCollection">
            <TYPE>{{ type }}</TYPE>
            {% if filters.length %}<FILTER>{% for filter in filters %}fltr_{{ filter.name }}{% if not loop.last %},{% endif %}{% endfor %}</FILTER>{% endif %}
          </COLLECTION>
          {% for filter in filters %}<SYSTEM TYPE="Formulae" NAME="fltr_{{ filter.name }}">{{ filter.expression }}</SYSTEM>
          {% endfor %}
        </TDLMESSAGE>
      </TDL>
    </DESC>
  </BODY>
</ENVELOPE>
